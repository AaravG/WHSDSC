"6" value="104"/><column index="8" value="92"/><column index="9" value="90"/><column index="10" value="119"/><column index="11" value="117"/><column index="12" value="94"/><column index="13" value="92"/><column index="14" value="121"/><column index="15" value="119"/><column index="16" value="76"/><column index="17" value="151"/><column index="18" value="149"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="kNN" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="78"/><column index="2" value="93"/><column index="3" value="93"/><column index="4" value="101"/><column index="5" value="55"/><column index="6" value="117"/><column index="7" value="117"/><column index="8" value="117"/><column index="9" value="117"/><column index="10" value="109"/><column index="11" value="109"/><column index="12" value="62"/><column index="13" value="83"/><column index="14" value="76"/><column index="15" value="60"/><column index="16" value="91"/><column index="17" value="76"/><column index="18" value="82"/><column index="19" value="74"/><column index="20" value="58"/><column index="21" value="89"/><column index="22" value="74"/><column index="23" value="163"/><column index="24" value="139"/><column index="25" value="162"/><column index="26" value="138"/><column index="27" value="66"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="season_summary" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="7" mode="1"/></sort><column_widths><column index="1" value="101"/><column index="2" value="34"/><column index="3" value="42"/><column index="4" value="53"/><column index="5" value="60"/><column index="6" value="60"/><column index="7" value="85"/><column index="8" value="67"/><column index="9" value="75"/><column index="10" value="60"/><column index="11" value="43"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="standings" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="101"/><column index="2" value="34"/><column index="3" value="42"/><column index="4" value="53"/><column index="5" value="60"/><column index="6" value="60"/><column index="7" value="85"/><column index="8" value="67"/><column index="9" value="75"/><column index="10" value="60"/><column index="11" value="43"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="game_summary">-- /*
-- CREATE TABLE data_new AS
-- SELECT game_id, record_id, home_team, away_team, home_goals, away_goals
-- FROM data
-- */
-- 
-- /*
-- CREATE TABLE data_final AS
-- SELECT game_id, home_team, away_team,
--        SUM(home_goals) AS home_goals,
--        SUM(away_goals) AS away_goals
-- FROM data_new
-- GROUP BY game_id, home_team, away_team;
-- */
-- 
-- /*
-- DROP TABLE data_new;
-- */
-- 
-- /*
-- CREATE TABLE data_new AS
-- SELECT *
-- FROM data_final
-- */
-- 
-- /*
-- SELECT *
-- From data_new
-- */
-- 
-- /*
-- CREATE TABLE data_clean AS
-- SELECT game_id, home_team, away_team,
--        SUM(home_goals) AS home_goals,
--        SUM(away_goals) AS away_goals,
--        SUM(toi)        AS game_time
-- FROM data
-- GROUP BY game_id, home_team, away_team;
-- */
-- 
-- /*
-- DROP TABLE data_final;
-- */
-- 
-- /*
-- ALTER TABLE data_clean ADD COLUMN overtime INTEGER;
-- 
-- UPDATE data_clean
-- SET overtime = CASE
--     WHEN game_time &gt; 3600 THEN 1
--     ELSE 0
-- END;
-- */
-- 
-- /*
-- ALTER TABLE data_clean ADD COLUMN home_win INTEGER;
-- 
-- UPDATE data_clean
-- SET home_win = CASE
-- 	WHEN home_goals &gt; away_goals THEN 1
-- 	ELSE 0
-- END;
-- 
-- ALTER TABLE data_clean ADD COLUMN away_win INTEGER;
-- 
-- UPDATE data_clean
-- SET away_win = CASE
--     WHEN away_goals &gt; home_goals THEN 1
--     ELSE 0
-- END;
-- */
-- 
-- 
-- ALTER TABLE data_clean ADD COLUMN home_ot_win INTEGER;
-- 
-- UPDATE game_summary
-- SET home_ot_win = CASE
-- 	WHEN went_ot = 1 AND home_win = 1 THEN 1
-- 	WHEN went_ot = 1 AND home_win = 0 THEN 0
-- 	ELSE 0
-- END;
-- 
-- ALTER TABLE data_clean ADD COLUMN away_ot_win INTEGER;
-- 
-- UPDATE game_summary
-- SET away_ot_win = CASE
-- 	WHEN went_ot = 1 AND away_win = 1 THEN 1
-- 	WHEN went_ot = 1 AND away_win = 0 THEN 0
-- 	ELSE 0
-- END;
-- 
-- 
-- 
-- ALTER TABLE data_clean ADD COLUMN home_loss INTEGER;
-- 
-- UPDATE game_summary
-- SET home_loss = CASE
-- 	WHEN home_win = 0 THEN 1
-- 	ELSE 0
-- END;
-- 
-- ALTER TABLE data_clean ADD COLUMN away_loss INTEGER;
-- 
-- UPDATE game_summary
-- SET away_loss = CASE
-- 	WHEN away_win = 0 THEN 1
-- 	ELSE 0
-- END;
-- 
-- 
-- 
-- ALTER TABLE data_clean ADD COLUMN home_ot_loss INTEGER;
-- 
-- UPDATE game_summary
-- SET home_ot_loss = CASE
-- 	WHEN went_ot = 1 AND home_win = 0 THEN 1
-- 	WHEN went_ot = 1 AND home_win = 1 THEN 0
-- 	ELSE 0
-- END;
-- 
-- ALTER TABLE data_clean ADD COLUMN away_ot_loss INTEGER;
-- 
-- UPDATE game_summary
-- SET away_ot_loss = CASE
-- 	WHEN went_ot = 1 AND away_win = 0 THEN 1
-- 	WHEN went_ot = 1 AND away_win = 1 THEN 0
-- 	ELSE 0
-- END;
-- 
-- 
-- 
-- /*
-- ALTER TABLE data_clean
-- RENAME TO game_summary;
-- 
-- DROP TABLE data_new;
-- */
-- 
-- /*
-- ALTER TABLE game_summary DROP COLUMN overtime;
-- ALTER TABLE game_summary ADD COLUMN went_ot INTEGER;
-- UPDATE game_summary
-- SET went_ot = (SELECT went_ot FROM data WHERE data.game_id = game_summary.game_id);
-- */

SELECT *
FROM game_summary</sql><sql name="season_summary">-- 
-- CREATE TABLE season_summary AS
-- SELECT team,
--        SUM(CASE WHEN went_ot = 0 AND win = 1 THEN 1 ELSE 0 END) AS wins,
--        SUM(CASE WHEN went_ot = 0 AND win = 0 THEN 1 ELSE 0 END) AS losses,
--        SUM(CASE WHEN went_ot = 1 AND win = 1 THEN 1 ELSE 0 END) AS ot_wins,
--        SUM(CASE WHEN went_ot = 1 AND win = 0 THEN 1 ELSE 0 END) AS ot_losses,
-- 	   SUM(goals_for) AS goals_for,
-- 	   SUM(goals_against) AS goals_against
-- FROM (
--     SELECT home_team AS team, went_ot, home_win AS win,
--        home_goals AS goals_for, away_goals AS goals_against
-- 	FROM game_summary
-- 	UNION ALL
-- 	SELECT away_team AS team, went_ot, away_win AS win,
-- 		   away_goals AS goals_for, home_goals AS goals_against
-- 	FROM game_summary
-- )
-- GROUP BY team;
-- 
-- 
-- 
-- ALTER TABLE season_summary ADD COLUMN total_wins   INTEGER;
-- ALTER TABLE season_summary ADD COLUMN total_losses INTEGER;
-- ALTER TABLE season_summary ADD COLUMN goals_dif    INTEGER;
-- 
-- UPDATE season_summary
-- SET total_wins   = wins + ot_wins,
--     total_losses = losses + ot_losses,
--     goals_dif    = goals_for - goals_against;
-- 
-- 
-- 
-- ALTER TABLE season_summary ADD COLUMN points INTEGER;
-- 
-- UPDATE season_summary
-- SET points = (2*wins) + (2*ot_wins) + (1*ot_losses);


SELECT *
FROM season_summary

</sql><sql name="standings">-- 
-- CREATE TABLE standings AS
-- SELECT *
-- FROM season_summary
-- ORDER BY points DESC;


SELECT *
FROM standings

</sql><sql name="kNN">-- CREATE TABLE kNN AS
-- SELECT *
-- FROM data;
-- 
-- ALTER TABLE kNN ADD COLUMN home_win INTEGER;


-- UPDATE kNN
-- SET home_win = game_summary.home_win
-- FROM game_summary
-- WHERE kNN.game_id = game_summary.game_id;</sql><sql name="sample">-- CREATE TABLE NN AS
-- SELECT *
-- FROM game_summary
-- ORDER BY CAST(REPLACE(game_id, 'game_', '') AS INTEGER) ASC;

-- CREATE TABLE data_sample AS
-- SELECT *
-- FROM data
-- ORDER BY CAST(REPLACE(game_id, 'game_', '') AS INTEGER) ASC;
-- 
ALTER TABLE NN ADD COLUMN home_assists   INTEGER;
ALTER TABLE NN ADD COLUMN home_shots INTEGER;
ALTER TABLE NN ADD COLUMN home_xg    INTEGER;
ALTER TABLE NN ADD COLUMN home_max_xg   INTEGER;
ALTER TABLE NN ADD COLUMN home_penalties_committed INTEGER;
ALTER TABLE NN ADD COLUMN home_penalty_minutes    INTEGER;

ALTER TABLE NN ADD COLUMN away_assists   INTEGER;
ALTER TABLE NN ADD COLUMN away_shots INTEGER;
ALTER TABLE NN ADD COLUMN away_xg    INTEGER;
ALTER TABLE NN ADD COLUMN away_max_xg   INTEGER;
ALTER TABLE NN ADD COLUMN away_penalties_committed INTEGER;
ALTER TABLE NN ADD COLUMN away_penalty_minutes    INTEGER;

UPDATE NN
SET
    home_assists = (
        SELECT SUM(home_assists)
        FROM data_sample ds
        WHERE ds.game_id = NN.game_id
    ),
    home_shots = (
        SELECT SUM(home_shots)
        FROM data_sample ds
        WHERE ds.game_id = NN.game_id
    ),
    home_xg = (
        SELECT AVG(home_xg)
        FROM data_sample ds
        WHERE ds.game_id = NN.game_id
    ),
    home_max_xg = (
        SELECT AVG(home_max_xg)
        FROM data_sample ds
        WHERE ds.game_id = NN.game_id
    ),
    home_penalties_committed = (
        SELECT SUM(home_penalties_committed)
        FROM data_sample ds
        WHERE ds.game_id = NN.game_id
    ),
    home_penalty_minutes = (
        SELECT SUM(home_penalty_minutes)
        FROM data_sample ds
        WHERE ds.game_id = NN.game_id
    ),

    away_assists = (
        SELECT SUM(away_assists)
        FROM data_sample ds
        WHERE ds.game_id = NN.game_id
    ),
    away_shots = (
        SELECT SUM(away_shots)
        FROM data_sample ds
        WHERE ds.game_id = NN.game_id
    ),
    away_xg = (
        SELECT AVG(away_xg)
        FROM data_sample ds
        WHERE ds.game_id = NN.game_id
    ),
    away_max_xg = (
        SELECT AVG(away_max_xg)
        FROM data_sample ds
        WHERE ds.game_id = NN.game_id
    ),
    away_penalties_committed = (
        SELECT SUM(away_penalties_committed)
        FROM data_sample ds
        WHERE ds.game_id = NN.game_id
    ),
    away_penalty_minutes = (
        SELECT SUM(away_penalty_minutes)
        FROM data_sample ds
        WHERE ds.game_id = NN.game_id
    );


	
SELECT *
FROM NN
</sql><sql name="SQL 6">-- DROP TABLE game_with_elo;

-- CREATE TABLE game_summary_sample AS
-- SELECT *
-- FROM game_summary
-- ORDER BY CAST(REPLACE(game_id, 'game_', '') AS INTEGER) ASC;

-- Create a table with game numbers
CREATE TABLE game_with_elo AS
WITH numbered_games AS (
    SELECT 
        ROW_NUMBER() OVER (ORDER BY CAST(REPLACE(game_id, 'game_', '') AS INTEGER) ASC) as game_num,
        *
    FROM game_summary_sample
),
-- Get all unique teams
all_teams AS (
    SELECT DISTINCT home_team as team FROM game_summary_sample
    UNION
    SELECT DISTINCT away_team as team FROM game_summary_sample
)
SELECT 
    ng.*,
    1000.0 as home_elo_before,
    1000.0 as away_elo_before
FROM numbered_games ng;

-- Now we need to iteratively update - this requires a script
-- Save this as update_elo.sql and run multiple times:

UPDATE game_with_elo
SET 
    home_elo_before = (
        SELECT COALESCE(
            1000.0 + SUM(
                20 * (
                    CASE 
                        WHEN prev.home_team = game_with_elo.home_team THEN
                            CASE 
                                WHEN prev.home_goals &gt; prev.away_goals THEN 1.0
                                WHEN prev.home_goals &lt; prev.away_goals THEN 0.0
                                ELSE 0.5
                            END - (1.0 / (1.0 + POWER(10, (prev.away_elo_before - prev.home_elo_before) / 400.0)))
                        WHEN prev.away_team = game_with_elo.home_team THEN
                            CASE 
                                WHEN prev.away_goals &gt; prev.home_goals THEN 1.0
                                WHEN prev.away_goals &lt; prev.home_goals THEN 0.0
                                ELSE 0.5
                            END - (1.0 / (1.0 + POWER(10, (prev.home_elo_before - prev.away_elo_before) / 400.0)))
                    END
                )
            ),
            1000.0
        )
        FROM game_with_elo prev
        WHERE prev.game_num &lt; game_with_elo.game_num
        AND (prev.home_team = game_with_elo.home_team OR prev.away_team = game_with_elo.home_team)
    ),
    away_elo_before = (
        SELECT COALESCE(
            1000.0 + SUM(
                20 * (
                    CASE 
                        WHEN prev.home_team = game_with_elo.away_team THEN
                            CASE 
                                WHEN prev.home_goals &gt; prev.away_goals THEN 1.0
                                WHEN prev.home_goals &lt; prev.away_goals THEN 0.0
                                ELSE 0.5
                            END - (1.0 / (1.0 + POWER(10, (prev.away_elo_before - prev.home_elo_before) / 400.0)))
                        WHEN prev.away_team = game_with_elo.away_team THEN
                            CASE 
                                WHEN prev.away_goals &gt; prev.home_goals THEN 1.0
                                WHEN prev.away_goals &lt; prev.home_goals THEN 0.0
                                ELSE 0.5
                            END - (1.0 / (1.0 + POWER(10, (prev.home_elo_before - prev.away_elo_before) / 400.0)))
                    END
                )
            ),
            1000.0
        )
        FROM game_with_elo prev
        WHERE prev.game_num &lt; game_with_elo.game_num
        AND (prev.home_team = game_with_elo.away_team OR prev.away_team = game_with_elo.away_team)
    );</sql><current_tab id="5"/></tab_sql></sqlb_project>
