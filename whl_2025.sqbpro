<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="" readonly="0" foreign_keys="" case_sensitive_like="" temp_store="" wal_autocheckpoint="" synchronous=""/><attached/><window><main_tabs open="structure browser pragmas query" current="1"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="3829"/><column_width id="4" width="0"/></tab_structure><tab_browse><table title="." custom_title="0" dock_id="7" table="0,0:"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="game_summary">/*
CREATE TABLE data_new AS
SELECT game_id, record_id, home_team, away_team, home_goals, away_goals
FROM data
*/

/*
CREATE TABLE data_final AS
SELECT game_id, home_team, away_team,
       SUM(home_goals) AS home_goals,
       SUM(away_goals) AS away_goals
FROM data_new
GROUP BY game_id, home_team, away_team;
*/

/*
DROP TABLE data_new;
*/

/*
CREATE TABLE data_new AS
SELECT *
FROM data_final
*/

/*
SELECT *
From data_new
*/

/*
CREATE TABLE data_clean AS
SELECT game_id, home_team, away_team,
       SUM(home_goals) AS home_goals,
       SUM(away_goals) AS away_goals,
       SUM(toi)        AS game_time
FROM data
GROUP BY game_id, home_team, away_team;
*/

/*
DROP TABLE data_final;
*/

/*
ALTER TABLE data_clean ADD COLUMN overtime INTEGER;

UPDATE data_clean
SET overtime = CASE
    WHEN game_time &gt; 3600 THEN 1
    ELSE 0
END;
*/

/*
ALTER TABLE data_clean ADD COLUMN home_win INTEGER;

UPDATE data_clean
SET home_win = CASE
	WHEN home_goals &gt; away_goals THEN 1
	ELSE 0
END;

ALTER TABLE data_clean ADD COLUMN away_win INTEGER;

UPDATE data_clean
SET away_win = CASE
    WHEN away_goals &gt; home_goals THEN 1
    ELSE 0
END;
*/

/*
ALTER TABLE data_clean ADD COLUMN home_ot_win INTEGER;

UPDATE data_clean
SET home_ot_win = CASE
	WHEN overtime = 1 AND home_win = 1 THEN 1
	WHEN overtime = 1 AND home_win = 0 THEN 0
	ELSE 0
END;

ALTER TABLE data_clean ADD COLUMN away_ot_win INTEGER;

UPDATE data_clean
SET away_ot_win = CASE
	WHEN overtime = 1 AND away_win = 1 THEN 1
	WHEN overtime = 1 AND away_win = 0 THEN 0
	ELSE 0
END;
*/

/*
ALTER TABLE data_clean ADD COLUMN home_loss INTEGER;

UPDATE data_clean
SET home_loss = CASE
	WHEN home_win = 0 THEN 1
	ELSE 0
END;

ALTER TABLE data_clean ADD COLUMN away_loss INTEGER;

UPDATE data_clean
SET away_loss = CASE
	WHEN away_win = 0 THEN 1
	ELSE 0
END;



ALTER TABLE data_clean ADD COLUMN home_ot_loss INTEGER;

UPDATE data_clean
SET home_ot_loss = CASE
	WHEN overtime = 1 AND home_win = 0 THEN 1
	WHEN overtime = 1 AND home_win = 1 THEN 0
	ELSE 0
END;

ALTER TABLE data_clean ADD COLUMN away_ot_loss INTEGER;

UPDATE data_clean
SET away_ot_loss = CASE
	WHEN overtime = 1 AND away_win = 0 THEN 1
	WHEN overtime = 1 AND away_win = 1 THEN 0
	ELSE 0
END;

*/

/*
ALTER TABLE data_clean
RENAME TO game_summary;

DROP TABLE data_new;
*/

SELECT *
FROM game_summary</sql><sql name="season_summary">/*
CREATE TABLE season_summary AS
SELECT team,
       SUM(CASE WHEN overtime = 0 AND win = 1 THEN 1 ELSE 0 END) AS wins,
       SUM(CASE WHEN overtime = 0 AND win = 0 THEN 1 ELSE 0 END) AS losses,
       SUM(CASE WHEN overtime = 1 AND win = 1 THEN 1 ELSE 0 END) AS ot_wins,
       SUM(CASE WHEN overtime = 1 AND win = 0 THEN 1 ELSE 0 END) AS ot_losses,
	   SUM(goals_for) AS goals_for,
	   SUM(goals_against) AS goals_against
FROM (
    SELECT home_team AS team, overtime, home_win AS win,
       home_goals AS goals_for, away_goals AS goals_against
	FROM game_summary
	UNION ALL
	SELECT away_team AS team, overtime, away_win AS win,
		   away_goals AS goals_for, home_goals AS goals_against
	FROM game_summary
)
GROUP BY team;
*/

/*
ALTER TABLE season_summary ADD COLUMN total_wins   INTEGER;
ALTER TABLE season_summary ADD COLUMN total_losses INTEGER;
ALTER TABLE season_summary ADD COLUMN goals_dif    INTEGER;

UPDATE season_summary
SET total_wins   = wins + ot_wins,
    total_losses = losses + ot_losses,
    goals_dif    = goals_for - goals_against;
*/

/*
ALTER TABLE season_summary ADD COLUMN points INTEGER;

UPDATE season_summary
SET points = (2*wins) + (2*ot_wins) + (1*ot_losses);
*/

SELECT *
FROM season_summary</sql><sql name="standings">/*
CREATE TABLE standings AS
SELECT *
FROM season_summary
ORDER BY points DESC;
*/

SELECT *
FROM standings</sql><sql name="SQL 4*">SELECT name FROM sqlite_master WHERE type='table';</sql><current_tab id="3"/></tab_sql></sqlb_project>
