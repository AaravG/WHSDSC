 freeze_columns="0"><sort/><column_widths><column index="1" value="78"/><column index="2" value="101"/><column index="3" value="101"/><column index="4" value="76"/><column index="5" value="74"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="data_new" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="56"/><column index="2" value="61"/><column index="3" value="74"/><column index="4" value="73"/><column index="5" value="76"/><column index="6" value="74"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="Cleaning_Raw_Data">/*
CREATE TABLE data_new AS
SELECT game_id, record_id, home_team, away_team, home_goals, away_goals
FROM data
*/

/*
CREATE TABLE data_final AS
SELECT game_id, home_team, away_team,
       SUM(home_goals) AS home_goals,
       SUM(away_goals) AS away_goals
FROM data_new
GROUP BY game_id, home_team, away_team;
*/

/*
DROP TABLE data_new;
*/

/*
CREATE TABLE data_new AS
SELECT *
FROM data_final
*/

/*
SELECT *
From data_new
*/

/*
CREATE TABLE data_clean AS
SELECT game_id, home_team, away_team,
       SUM(home_goals) AS home_goals,
       SUM(away_goals) AS away_goals,
       SUM(toi)        AS game_time
FROM data
GROUP BY game_id, home_team, away_team;
*/

/*
DROP TABLE data_final;
*/

/*
ALTER TABLE data_clean ADD COLUMN overtime INTEGER;

UPDATE data_clean
SET overtime = CASE
    WHEN game_time &gt; 3600 THEN 1
    ELSE 0
END;
*/

SELECT *
FROM data_clean

</sql><current_tab id="0"/></tab_sql></sqlb_project>
