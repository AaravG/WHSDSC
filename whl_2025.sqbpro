ame="data_clean" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="56"/><column index="2" value="74"/><column index="3" value="73"/><column index="4" value="76"/><column index="5" value="74"/><column index="6" value="71"/><column index="7" value="58"/><column index="8" value="66"/><column index="9" value="65"/><column index="10" value="85"/><column index="11" value="83"/><column index="12" value="68"/><column index="13" value="66"/><column index="14" value="86"/><column index="15" value="85"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="data_new" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="78"/><column index="2" value="93"/><column index="3" value="93"/><column index="4" value="101"/><column index="5" value="76"/><column index="6" value="74"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="Cleaning_Raw_Data*">/*
CREATE TABLE data_new AS
SELECT game_id, record_id, home_team, away_team, home_goals, away_goals
FROM data
*/

/*
CREATE TABLE data_final AS
SELECT game_id, home_team, away_team,
       SUM(home_goals) AS home_goals,
       SUM(away_goals) AS away_goals
FROM data_new
GROUP BY game_id, home_team, away_team;
*/

/*
DROP TABLE data_new;
*/

/*
CREATE TABLE data_new AS
SELECT *
FROM data_final
*/

/*
SELECT *
From data_new
*/

/*
CREATE TABLE data_clean AS
SELECT game_id, home_team, away_team,
       SUM(home_goals) AS home_goals,
       SUM(away_goals) AS away_goals,
       SUM(toi)        AS game_time
FROM data
GROUP BY game_id, home_team, away_team;
*/

/*
DROP TABLE data_final;
*/

/*
ALTER TABLE data_clean ADD COLUMN overtime INTEGER;

UPDATE data_clean
SET overtime = CASE
    WHEN game_time &gt; 3600 THEN 1
    ELSE 0
END;
*/

/*
ALTER TABLE data_clean ADD COLUMN home_win INTEGER;

UPDATE data_clean
SET home_win = CASE
	WHEN home_goals &gt; away_goals THEN 1
	ELSE 0
END;

ALTER TABLE data_clean ADD COLUMN away_win INTEGER;

UPDATE data_clean
SET away_win = CASE
    WHEN away_goals &gt; home_goals THEN 1
    ELSE 0
END;
*/

/*
ALTER TABLE data_clean ADD COLUMN home_ot_win INTEGER;

UPDATE data_clean
SET home_ot_win = CASE
	WHEN overtime = 1 AND home_win = 1 THEN 1
	WHEN overtime = 1 AND home_win = 0 THEN 0
	ELSE 0
END;

ALTER TABLE data_clean ADD COLUMN away_ot_win INTEGER;

UPDATE data_clean
SET away_ot_win = CASE
	WHEN overtime = 1 AND away_win = 1 THEN 1
	WHEN overtime = 1 AND away_win = 0 THEN 0
	ELSE 0
END;
*/

/*
ALTER TABLE data_clean ADD COLUMN home_loss INTEGER;

UPDATE data_clean
SET home_loss = CASE
	WHEN home_win = 0 THEN 1
	ELSE 0
END;

ALTER TABLE data_clean ADD COLUMN away_loss INTEGER;

UPDATE data_clean
SET away_loss = CASE
	WHEN away_win = 0 THEN 1
	ELSE 0
END;



ALTER TABLE data_clean ADD COLUMN home_ot_loss INTEGER;

UPDATE data_clean
SET home_ot_loss = CASE
	WHEN overtime = 1 AND home_win = 0 THEN 1
	WHEN overtime = 1 AND home_win = 1 THEN 0
	ELSE 0
END;

ALTER TABLE data_clean ADD COLUMN away_ot_loss INTEGER;

UPDATE data_clean
SET away_ot_loss = CASE
	WHEN overtime = 1 AND away_win = 0 THEN 1
	WHEN overtime = 1 AND away_win = 1 THEN 0
	ELSE 0
END;

*/

/*
ALTER TABLE data_clean
RENAME TO game_summary;

DROP TABLE data_new;
*/

SELECT *
FROM game_summary</sql><current_tab id="0"/></tab_sql></sqlb_project>
